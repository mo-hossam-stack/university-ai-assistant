SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app-name.railway.app,your-app-name.netlify.app,localhost,
CSRF_TRUSTED_ORIGINS=your-app-name.railway.app,your-app-name.netlify.app
CORS_ALLOWED_ORIGINS=your-app-name.railway.app,your-app-name.netlify.app

# SQLite (default when DATABASE_URL is not set — local dev without Docker)
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@host:5432/dbname

GROQ_API_KEY=gsk_your_gro_api_key_here
