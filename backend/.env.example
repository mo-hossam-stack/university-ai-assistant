# Django
# Required — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
# Local development — set to False in production
DEBUG=True
# Comma-separated. Production example: your-app-name.railway.app,your-app-name.netlify.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins Django trusts for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Comma-separated origins allowed to call the API (the frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database — SQLite is used when DATABASE_URL is unset (no setup needed)
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq LLM
# Required — chat fails with 503 LLM_CONFIG_ERROR without this
GROQ_API_KEY=gsk_your_gro_api_key_here
# Required — chat fails with 503 LLM_CONFIG_ERROR without this
GROQ_MODEL=llama-3.3-70b-versatile
# Optional — defaults to GROQ_MODEL
GROQ_CLASSIFIER_MODEL=llama-3.3-70b-versatile

# Optional — defaults to 30/min per IP
ANON_THROTTLE_RATE=30/min
# Optional — forced on in production when DEBUG=False
# SECURE_SSL_REDIRECT=True
