# Required — Django fails at import without it
SECRET_KEY=your-secret-key-here
# Optional — defaults to False
DEBUG=False
# Required in production — comma-separated hostnames
ALLOWED_HOSTS=your-app-name.railway.app,your-app-name.netlify.app,localhost,
# Required in production — comma-separated origins
CSRF_TRUSTED_ORIGINS=your-app-name.railway.app,your-app-name.netlify.app
# Required in production — comma-separated origins
CORS_ALLOWED_ORIGINS=your-app-name.railway.app,your-app-name.netlify.app

# Optional — defaults to SQLite when unset (local dev without Docker)
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required — chat fails with 503 LLM_CONFIG_ERROR without this
GROQ_API_KEY=gsk_your_gro_api_key_here
# Required — chat fails with 503 LLM_CONFIG_ERROR without this
GROQ_MODEL=llama-3.3-70b-versatile
# Optional — defaults to GROQ_MODEL
GROQ_CLASSIFIER_MODEL=llama-3.3-70b-versatile

# Optional — defaults to 30/min per IP
ANON_THROTTLE_RATE=30/min
# Optional — defaults to True when DEBUG=False
SECURE_SSL_REDIRECT=True
